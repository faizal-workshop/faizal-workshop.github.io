---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <div class="flex flex-1 w-full">
        <aside class="p-6 border-e-1 border-zinc-400 w-56">
            <a href="/">
                <img src="/res/logo.svg" alt="Logo" class="w-36" />
            </a>
        </aside>
        <div class="flex flex-col flex-1">
            <main class="h-full max-h-[calc(100dvh-48px)] overflow-y-auto">
                <article class="p-6 min-h-[calc(100dvh-96px)]">
                    Coming Soon
                </article>
                <footer
                    class:list={[
                        'flex justify-end items-center px-6 bg-zinc-800 h-12',
                        'text-white text-sm border-t-1 border-zinc-400',
                    ]}
                >
                    <span data-copyright>Mfc &copy;</span>
                </footer>
            </main>
        </div>
    </div>
</Layout>

<script>
    const getYear = new Date().getFullYear();
    const currentYear = (getYear > 2018 ? `2018 - ` : '') + getYear;

    document.querySelector('[data-copyright]').append(` ${currentYear}`);
</script>
